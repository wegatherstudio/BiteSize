# Firebase client config — from Firebase Console > Project Settings > General > Your apps (Web app).
# Safe to expose to the browser (NEXT_PUBLIC_ prefix), scoped by firestore.rules / storage.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK — only needed for server-side scripts/cron (e.g. session
# cleanup). From Firebase Console > Project Settings > Service Accounts >
# Generate new private key. Never expose these without NEXT_PUBLIC_.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
